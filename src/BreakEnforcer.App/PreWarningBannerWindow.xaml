<Window x:Class="BreakEnforcer.App.PreWarningBannerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pre-Warning"
        SizeToContent="WidthAndHeight"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        Focusable="False"
        Opacity="0"
        Background="Transparent">
    <Border Background="#000000"
            BorderBrush="#262626"
            BorderThickness="1"
            CornerRadius="8"
            Padding="14,10">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock x:Name="MessageText"
                       Text="Break in 2 min"
                       Foreground="#FFFFFF"
                       FontFamily="Segoe UI"
                       FontSize="13"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"
                       Margin="0,0,14,0" />

            <Button x:Name="ExtendButton"
                    Content="+5 min"
                    Focusable="False"
                    Height="30"
                    Padding="12,0"
                    Margin="0,0,8,0"
                    Background="#101010"
                    Foreground="#FFFFFF"
                    BorderBrush="#262626"
                    BorderThickness="1"
                    FontFamily="Segoe UI"
                    FontSize="12"
                    FontWeight="SemiBold"
                    Cursor="Hand"
                    Click="OnExtendClick">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#181818" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <Button Focusable="False"
                    Width="28"
                    Height="28"
                    Background="Transparent"
                    BorderThickness="0"
                    ToolTip="Dismiss"
                    Cursor="Hand"
                    Click="OnDismissClick">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#181818" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
                <Path Width="12"
                      Height="12"
                      Stretch="Uniform"
                      Fill="#8E8E93"
                      Data="M18.3 5.71c-.39-.39-1.02-.39-1.41 0L12 10.59 7.11 5.7c-.39-.39-1.02-.39-1.41 0-.39.39-.39 1.02 0 1.41L10.59 12 5.7 16.89c-.39.39-.39 1.02 0 1.41.39.39 1.02.39 1.41 0L12 13.41l4.89 4.89c.39.39 1.02.39 1.41 0 .39-.39.39-1.02 0-1.41L13.41 12l4.89-4.89c.38-.38.38-1.02 0-1.4z" />
            </Button>
        </StackPanel>
    </Border>
</Window>

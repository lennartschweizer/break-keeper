<Window x:Class="BreakEnforcer.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:BreakEnforcer.Core;assembly=BreakEnforcer.Core"
        Title="{x:Static core:AppIdentity.DisplayName}"
        Width="400"
        Height="372"
        ResizeMode="CanMinimize"
        WindowStyle="SingleBorderWindow"
        WindowStartupLocation="CenterScreen"
        Background="#000000"
        Foreground="#FFFFFF"
        FontFamily="Segoe UI">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="36"
                      ResizeBorderThickness="0"
                      GlassFrameThickness="0"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <Style x:Key="PresetButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="#181818"/>
            <Setter Property="Foreground" Value="#8E8E93"/>
            <Setter Property="BorderBrush" Value="#262626"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="NumericInputStyle" TargetType="TextBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="#181818"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#262626"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CaretBrush" Value="#FFFFFF"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="6,0">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TitleBarButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#8E8E93"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#181818"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border BorderBrush="#262626" BorderThickness="1" Background="#000000">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Custom dark title bar -->
            <Grid Grid.Row="0" Background="#000000">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                    <Path Data="M8 2c-1.1 0-2 .9-2 2v3.17c0 .53.21 1.04.59 1.42L10 12l-3.42 3.42c-.37.38-.58.89-.58 1.42V20c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2v-3.16c0-.53-.21-1.04-.58-1.41L14 12l3.41-3.4c.38-.38.59-.89.59-1.42V4c0-1.1-.9-2-2-2H8zm8 14.5V19c0 .55-.45 1-1 1H9c-.55 0-1-.45-1-1v-2.5l4-4 4 4zm-4-5l-4-4V5c0-.55.45-1 1-1h6c.55 0 1 .45 1 1v2.5l-4 4z"
                          Fill="#8E8E93"
                          Width="14"
                          Height="14"
                          Stretch="Uniform"
                          Margin="0,0,8,0"/>
                    <TextBlock Text="{x:Static core:AppIdentity.DisplayName}"
                               FontSize="12"
                               Foreground="#8E8E93"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource TitleBarButtonStyle}" Click="OnMinimizeClick" ToolTip="Minimize">
                        <Path Data="M18 13H6c-.55 0-1-.45-1-1s.45-1 1-1h12c.55 0 1 .45 1 1s-.45 1-1 1z"
                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              Width="11"
                              Height="11"
                              Stretch="Uniform"/>
                    </Button>
                    <Button Style="{StaticResource TitleBarButtonStyle}" Click="OnCloseClick" ToolTip="Close">
                        <Path Data="M18.3 5.71c-.39-.39-1.02-.39-1.41 0L12 10.59 7.11 5.7c-.39-.39-1.02-.39-1.41 0-.39.39-.39 1.02 0 1.41L10.59 12 5.7 16.89c-.39.39-.39 1.02 0 1.41.39.39 1.02.39 1.41 0L12 13.41l4.89 4.89c.39.39 1.02.39 1.41 0 .39-.39.39-1.02 0-1.41L13.41 12l4.89-4.89c.38-.38.38-1.02 0-1.4z"
                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              Width="11"
                              Height="11"
                              Stretch="Uniform"/>
                    </Button>
                </StackPanel>
            </Grid>

            <StackPanel Grid.Row="1" Margin="28,0,28,36" VerticalAlignment="Center">
            <!-- State badge -->
            <TextBlock x:Name="StateBadgeText"
                       HorizontalAlignment="Center"
                       Text="IDLE"
                       FontFamily="Consolas"
                       FontSize="12"
                       FontWeight="Bold"
                       Foreground="#8E8E93"/>

            <!-- Monospace countdown timer -->
            <TextBlock x:Name="TimerText"
                       Text="50:00"
                       FontFamily="Consolas"
                       FontSize="58"
                       FontWeight="Bold"
                       Foreground="#FFFFFF"
                       HorizontalAlignment="Center"
                       Margin="0,6,0,0"/>

            <!-- Preset selector -->
            <Grid x:Name="PresetSelectorPanel" Margin="0,14,0,0" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="Preset50Button" Grid.Column="0" Content="50 / 10" Style="{StaticResource PresetButtonStyle}" Click="OnPreset50Click"/>
                <Button x:Name="Preset25Button" Grid.Column="2" Content="25 / 5" Style="{StaticResource PresetButtonStyle}" Click="OnPreset25Click"/>
                <Button x:Name="PresetCustomButton" Grid.Column="4" Content="Custom" Style="{StaticResource PresetButtonStyle}" Click="OnPresetCustomClick"/>
            </Grid>

            <!-- Custom duration row (visible only when Custom selected in Idle) -->
            <Grid x:Name="CustomDurationPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,12,0,0" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="64"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="64"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Focus (min)" Foreground="#8E8E93" FontSize="12" VerticalAlignment="Center"/>
                <TextBox x:Name="CustomFocusBox" Grid.Column="2" Text="45" Style="{StaticResource NumericInputStyle}" TextChanged="OnCustomMinutesChanged"/>
                <TextBlock Grid.Column="4" Text="Break (min)" Foreground="#8E8E93" FontSize="12" VerticalAlignment="Center"/>
                <TextBox x:Name="CustomBreakBox" Grid.Column="6" Text="10" Style="{StaticResource NumericInputStyle}" TextChanged="OnCustomMinutesChanged"/>
            </Grid>

            <!-- Primary action button -->
            <Button x:Name="StartButton"
                    Height="40"
                    Margin="0,14,0,0"
                    VerticalAlignment="Center"
                    Content="Start Focus"
                    FontSize="14"
                    FontWeight="SemiBold"
                    BorderThickness="0"
                    Cursor="Hand"
                    Click="OnStartClick">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="#FFFFFF"/>
                        <Setter Property="Foreground" Value="#000000"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="6">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter TargetName="Root" Property="Background" Value="#181818"/>
                                            <Setter Property="Foreground" Value="#8E8E93"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Button.Style>
            </Button>

            <!-- +5 min extension control (pre-warning only) -->
            <Button x:Name="ExtendButton"
                    HorizontalAlignment="Center"
                    Margin="0,18,0,0"
                    Height="34"
                    Padding="20,0"
                    Visibility="Collapsed"
                    Content="+5 min"
                    FontFamily="Consolas"
                    FontSize="12"
                    FontWeight="Bold"
                    BorderThickness="0"
                    Cursor="Hand"
                    Click="OnExtendClick">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="#FFFFFF"/>
                        <Setter Property="Foreground" Value="#000000"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter TargetName="Root" Property="Background" Value="#181818"/>
                                            <Setter Property="Foreground" Value="#8E8E93"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Button.Style>
            </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>

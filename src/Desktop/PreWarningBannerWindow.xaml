<Window x:Class="Desktop.PreWarningBannerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pre-Warning"
        SizeToContent="WidthAndHeight"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        Focusable="False"
        Opacity="0"
        Background="Transparent">
    <Border Background="{StaticResource SurfacePrimaryBrush}"
            CornerRadius="8"
            Padding="14,10">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock x:Name="MessageText"
                       Text="Break in 2 min"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       FontFamily="{StaticResource FontUi}"
                       FontSize="13"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"
                       Margin="0,0,14,0" />

            <Button x:Name="ExtendButton"
                    Content="+5 min"
                    Focusable="False"
                    Margin="0,0,8,0"
                    Style="{StaticResource CompactPrimaryButtonStyle}"
                    Click="OnExtendClick"/>

            <Button Focusable="False"
                    ToolTip="Dismiss"
                    Style="{StaticResource CompactIconButtonStyle}"
                    Click="OnDismissClick">
                <Path Width="12"
                      Height="12"
                      Stretch="Uniform"
                      Fill="{StaticResource TextSecondaryBrush}"
                      Data="M18.3 5.71c-.39-.39-1.02-.39-1.41 0L12 10.59 7.11 5.7c-.39-.39-1.02-.39-1.41 0-.39.39-.39 1.02 0 1.41L10.59 12 5.7 16.89c-.39.39-.39 1.02 0 1.41.39.39 1.02.39 1.41 0L12 13.41l4.89 4.89c.39.39 1.02.39 1.41 0 .39-.39.39-1.02 0-1.41L13.41 12l4.89-4.89c.38-.38.38-1.02 0-1.4z" />
            </Button>
        </StackPanel>
    </Border>
</Window>

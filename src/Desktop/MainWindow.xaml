<Window x:Class="Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:Core;assembly=Core"
        Title="{x:Static core:AppIdentity.DisplayName}"
        Width="400"
        Height="372"
        ResizeMode="CanMinimize"
        WindowStyle="SingleBorderWindow"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource SurfacePrimaryBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="{StaticResource FontUi}">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="36"
                      ResizeBorderThickness="0"
                      GlassFrameThickness="0"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Border BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" Background="{StaticResource SurfacePrimaryBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Custom dark title bar -->
            <Grid Grid.Row="0" Background="#000000">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                    <Path Data="M5.5 21q-.213 0-.356-.144T5 20.499t.144-.356T5.5 20h1.308v-3q0-1.852 1.135-3.285T10.853 12q-1.774-.3-2.91-1.724T6.808 7V4H5.5q-.213 0-.356-.144T5 3.499t.144-.356T5.5 3h13q.213 0 .356.144t.144.357t-.144.356T18.5 4h-1.308v3q0 1.852-1.135 3.276T13.147 12q1.774.28 2.91 1.715q1.135 1.433 1.135 3.285v3H18.5q.213 0 .356.144t.144.357t-.144.356T18.5 21z"
                          Fill="{StaticResource TextSecondaryBrush}"
                          Width="14"
                          Height="14"
                          Stretch="Uniform"
                          Margin="0,0,8,0"/>
                    <TextBlock Text="{x:Static core:AppIdentity.DisplayName}"
                               FontSize="12"
                               Foreground="#8E8E93"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource TitleBarButtonStyle}" Click="OnMinimizeClick" ToolTip="Minimize">
                        <Path Data="M18 13H6c-.55 0-1-.45-1-1s.45-1 1-1h12c.55 0 1 .45 1 1s-.45 1-1 1z"
                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              Width="11"
                              Height="11"
                              Stretch="Uniform"/>
                    </Button>
                    <Button Style="{StaticResource TitleBarButtonStyle}" Click="OnCloseClick" ToolTip="Close">
                        <Path Data="M18.3 5.71c-.39-.39-1.02-.39-1.41 0L12 10.59 7.11 5.7c-.39-.39-1.02-.39-1.41 0-.39.39-.39 1.02 0 1.41L10.59 12 5.7 16.89c-.39.39-.39 1.02 0 1.41.39.39 1.02.39 1.41 0L12 13.41l4.89 4.89c.39.39 1.02.39 1.41 0 .39-.39.39-1.02 0-1.41L13.41 12l4.89-4.89c.38-.38.38-1.02 0-1.4z"
                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              Width="11"
                              Height="11"
                              Stretch="Uniform"/>
                    </Button>
                </StackPanel>
            </Grid>

            <StackPanel Grid.Row="1" Margin="28,0,28,36" VerticalAlignment="Center">
            <!-- State badge -->
            <TextBlock x:Name="StateBadgeText"
                       Text="IDLE"
                       Style="{StaticResource PhaseBadgeStyle}"/>

            <!-- Monospace countdown timer -->
            <TextBlock x:Name="TimerText"
                       Text="50:00"
                       FontFamily="{StaticResource FontMono}"
                       FontSize="58"
                       FontWeight="Bold"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       HorizontalAlignment="Center"
                       Margin="0,6,0,0"/>

            <!-- Duration inputs (always visible in Idle, zero layout shift) -->
            <Grid x:Name="CustomDurationPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="64"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="64"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Focus (min)" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center"/>
                <TextBox x:Name="CustomFocusBox"
                         Grid.Column="2"
                         Text="25"
                         MaxLength="3"
                         Style="{StaticResource NumericInputStyle}"
                         TextChanged="OnCustomMinutesChanged"
                         PreviewTextInput="OnNumericPreviewTextInput"
                         PreviewKeyDown="OnNumericPreviewKeyDown"
                         GotKeyboardFocus="OnNumericGotKeyboardFocus"
                         PreviewMouseLeftButtonDown="OnNumericPreviewMouseLeftButtonDown"/>
                <TextBlock Grid.Column="4" Text="Break (min)" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center"/>
                <TextBox x:Name="CustomBreakBox"
                         Grid.Column="6"
                         Text="5"
                         MaxLength="3"
                         Style="{StaticResource NumericInputStyle}"
                         TextChanged="OnCustomMinutesChanged"
                         PreviewTextInput="OnNumericPreviewTextInput"
                         PreviewKeyDown="OnNumericPreviewKeyDown"
                         GotKeyboardFocus="OnNumericGotKeyboardFocus"
                         PreviewMouseLeftButtonDown="OnNumericPreviewMouseLeftButtonDown"/>
            </Grid>

            <!-- Primary action button -->
            <Button x:Name="StartButton"
                    Height="46"
                    Margin="0,12,0,0"
                    VerticalAlignment="Center"
                    Content="Start Focus"
                    FontSize="14"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Click="OnStartClick"/>

            <!-- +5 min extension control (pre-warning only) -->
            <Button x:Name="ExtendButton"
                    HorizontalAlignment="Center"
                    Margin="0,18,0,0"
                    Height="40"
                    Padding="20,0"
                    Visibility="Collapsed"
                    Content="+5 min"
                    FontFamily="{StaticResource FontMono}"
                    FontSize="12"
                    FontWeight="Bold"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Click="OnExtendClick"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>

<Window x:Class="Desktop.BreakOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:Core;assembly=Core"
        Title="{x:Static core:AppIdentity.BreakWindowTitle}"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Background="{StaticResource SurfacePrimaryBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="{StaticResource FontUi}">
    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Center: Break countdown & break-complete actions -->
        <StackPanel Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock x:Name="PhaseTitleText"
                       Text="BREAK"
                       Style="{StaticResource PhaseBadgeStyle}"
                       Margin="0,0,0,12"/>
            <TextBlock x:Name="CountdownText"
                       Text="10:00"
                       FontSize="84"
                       Style="{StaticResource TimerDisplayStyle}"/>

            <StackPanel x:Name="BreakCompleteActions"
                        Orientation="Vertical"
                        Width="220"
                        HorizontalAlignment="Center"
                        Margin="0,28,0,0"
                        Visibility="Collapsed">
                <Button x:Name="StartNextFocusButton"
                        Content="Start Next Focus"
                        IsDefault="True"
                        Height="44"
                        Padding="18,0"
                        Margin="0,0,0,8"
                        FontSize="13"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Click="OnStartNextFocusClick"/>
                <Button x:Name="StopIdleButton"
                        Content="Stop (Idle)"
                        Height="44"
                        Padding="18,0"
                        FontSize="13"
                        Style="{StaticResource FilledButtonStyle}"
                        Click="OnStopToIdleClick"/>
            </StackPanel>
        </StackPanel>

        <!-- Bottom: Single 15s hold-only emergency exit control -->
        <Button x:Name="EmergencyExitButton"
                Grid.Row="1"
                Width="220"
                Height="36"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Margin="0,0,0,12"
                Content="Emergency Exit (Hold)"
                FontSize="12"
                Style="{StaticResource FilledButtonStyle}"
                PreviewMouseLeftButtonDown="OnHoldStart"
                PreviewMouseLeftButtonUp="OnHoldCancel"
                MouseLeave="OnHoldLeave"
                PreviewKeyDown="OnHoldButtonPreviewKeyDown"
                PreviewKeyUp="OnHoldButtonPreviewKeyUp"
                LostKeyboardFocus="OnHoldButtonLostFocus"/>
    </Grid>
</Window>

<Window x:Class="FocusEnforcer.App.PreWarningBannerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pre-Warning"
        SizeToContent="WidthAndHeight"
        WindowStyle="None"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        Focusable="False"
        Background="#000000">
    <Border Background="#000000"
            BorderBrush="#262626"
            BorderThickness="1"
            Padding="14,10">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                <TextBlock Text="BREAK IN"
                           Foreground="#FF9F0A"
                           FontFamily="Segoe UI"
                           FontSize="10"
                           FontWeight="SemiBold" />
                <TextBlock x:Name="CountdownText"
                           Text="02:00"
                           Foreground="#FFFFFF"
                           FontFamily="Consolas"
                           FontSize="20"
                           FontWeight="Bold" />
            </StackPanel>

            <Button x:Name="ExtendButton"
                    Content="+5 min"
                    Focusable="False"
                    Height="30"
                    Padding="12,0"
                    Margin="0,0,8,0"
                    Background="#101010"
                    Foreground="#FF9F0A"
                    BorderBrush="#262626"
                    BorderThickness="1"
                    FontFamily="Segoe UI"
                    FontSize="12"
                    FontWeight="SemiBold"
                    Cursor="Hand"
                    Click="OnExtendClick">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#181818" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <Button Focusable="False"
                    Width="28"
                    Height="28"
                    Background="Transparent"
                    BorderThickness="0"
                    ToolTip="Dismiss"
                    Cursor="Hand"
                    Click="OnDismissClick">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#181818" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
                <Path Width="12"
                      Height="12"
                      Stretch="Uniform"
                      Fill="#8E8E93"
                      Data="M19,6.41 L17.59,5 L12,10.59 L6.41,5 L5,6.41 L10.59,12 L5,17.59 L6.41,19 L12,13.41 L17.59,19 L19,17.59 L13.41,12 Z" />
            </Button>
        </StackPanel>
    </Border>
</Window>
